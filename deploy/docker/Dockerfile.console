FROM golang:1.26.6-trixie AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go test ./cmd/kingconsole ./internal/platform ./internal/netguard && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w -X main.version=1.4.0' -o /out/kingconsole ./cmd/kingconsole

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/kingconsole /usr/local/bin/kingconsole
EXPOSE 18889
ENTRYPOINT ["/usr/local/bin/kingconsole"]
# Safe standalone default: the UI can start without weakening the rule that
# non-loopback upstream API targets require HTTPS. A separate-container
# deployment must explicitly supply -api https://<trusted-kingagentd-endpoint>.
CMD ["-listen","0.0.0.0:18889","-api","http://127.0.0.1:18888"]
