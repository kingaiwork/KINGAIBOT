FROM golang:1.26.6-trixie AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go test ./cmd/kingworker ./internal/cluster ./internal/storage ./internal/netguard && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w -X main.version=1.3.0' -o /out/kingworker ./cmd/kingworker && \
    mkdir -p /out/data && chmod 0700 /out/data

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/kingworker /usr/local/bin/kingworker
COPY --from=build --chown=65532:65532 /out/data /data
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/kingworker"]
CMD ["-workspace","/data"]
