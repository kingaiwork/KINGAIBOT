# KINGAIBOT local identities. Generate independent random values.
KINGAGENT_ADMIN_TOKEN=replace-with-random-admin-token
KINGAGENT_MCP_TOKEN=replace-with-random-mcp-token
KINGAGENT_A2A_TOKEN=replace-with-random-a2a-token

# AI provider key referenced by configs/config.example.json.
OPENAI_API_KEY=replace-with-provider-api-key

# KING AI Enterprise Workforce node token.
# Obtain it once from https://www.kingai.work/enterprise/ after registering this machine.
KINGAI_WORKFORCE_NODE_TOKEN=knode_replace-with-issued-token

# Production default. Change only when operating a separately approved control plane.
KINGAI_WORKFORCE_URL=https://api.kingai.work

# Privacy default: only success/failure is sent back to the cloud control plane.
KINGAI_WORKFORCE_REPORT_OUTPUT=false

# Optional operational tuning.
KINGAI_WORKFORCE_HEARTBEAT_SECONDS=60
KINGAI_WORKFORCE_SYNC_SECONDS=120
KINGAI_WORKFORCE_POLL_SECONDS=8
KINGAI_WORKFORCE_REQUEST_TIMEOUT_SECONDS=30
KINGAI_WORKFORCE_MAX_REPORT_BYTES=8192

# Development only: allows http://localhost / loopback control planes.
KINGAI_WORKFORCE_ALLOW_INSECURE_HTTP=false
