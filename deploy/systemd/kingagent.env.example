# KINGAIBOT local secrets / runtime environment
# Install as /etc/kingagent/kingagent.env with owner root:kingagent and mode 0640
# (or stricter). Never commit the populated file.

# Model provider credentials remain customer-local.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional KING AI Enterprise Workforce connection.
# Copy the one-time service token shown by the KING AI Workforce console.
KINGAI_WORKFORCE_URL=https://api.kingai.work
KINGAI_WORKFORCE_SERVICE_TOKEN=

# Local authority mapping. This file must be 0600 on Unix because it maps
# cloud digital employees to LOCAL agent identities whose capability envelopes
# may be resolved by the v14 Authority Store.
KINGAI_WORKFORCE_BINDINGS_FILE=/var/lib/kingagent/workforce/bindings.json

# Privacy default: do not upload local model output to the cloud control plane.
KINGAI_WORKFORCE_REPORT_OUTPUT=false
KINGAI_WORKFORCE_MAX_REPORT_BYTES=8192

# Conservative network cadence. Values are clamped by the client.
KINGAI_WORKFORCE_HEARTBEAT_SECONDS=60
KINGAI_WORKFORCE_SYNC_SECONDS=120
KINGAI_WORKFORCE_POLL_SECONDS=8
KINGAI_WORKFORCE_REQUEST_TIMEOUT_SECONDS=30

# Development only; production must use HTTPS. Even when true, HTTP is accepted
# only for localhost/loopback addresses.
KINGAI_WORKFORCE_ALLOW_INSECURE_HTTP=false
