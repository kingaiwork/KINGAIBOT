{
  "schema": "kingai.project.v1",
  "product_id": "kingaibot",
  "name": "KINGAIBOT",
  "role": "governed-agent-runtime",
  "visibility": "public",
  "governance_source": "kingaiwork/KINGAIASE",
  "platform": {
    "api_origin": "https://api.kingai.work",
    "identity_mode": "federated-client",
    "direct_core_data_access": false,
    "cloud_identity_authority": false,
    "cloud_billing_authority": false,
    "cloud_entitlement_authority": false
  },
  "runtime": {
    "authority": "local-policy-bound",
    "data": "local-runtime",
    "provider_credentials": "environment-or-secret-store-only",
    "model_authority": false,
    "execution_authority": "capability-envelope-policy-approval"
  },
  "interoperability": ["MCP", "A2A", "remote-workers", "channels"],
  "security": {
    "self_grant_authority": false,
    "self_approve_high_risk": false,
    "self_promote_trusted_memory": false,
    "reconciliation_for_ambiguous_side_effects": true
  }
}
