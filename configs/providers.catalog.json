{
  "description": "Reference provider blocks for KINGAIBOT. Copy desired entries into config.json providers and enable them. Secrets are always referenced by environment-variable name, never stored here.",
  "providers": [
    {
      "name": "openai",
      "type": "openai-compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "model": "replace-with-available-openai-model",
      "priority": 10,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "anthropic",
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "model": "replace-with-available-claude-model",
      "priority": 20,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "gemini",
      "type": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key_env": "GEMINI_API_KEY",
      "model": "replace-with-available-gemini-model",
      "priority": 30,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "openrouter",
      "type": "openai-compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "model": "replace-with-openrouter-model-slug",
      "priority": 40,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "groq",
      "type": "openai-compatible",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "model": "replace-with-groq-model-id",
      "priority": 50,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "generic-openai-compatible-cloud",
      "type": "openai-compatible",
      "base_url": "https://replace-with-provider-base-url/v1",
      "api_key_env": "COMPATIBLE_MODEL_API_KEY",
      "model": "replace-with-provider-model-id",
      "priority": 60,
      "enabled": false,
      "allow_private_network": false,
      "allow_insecure_http": false
    },
    {
      "name": "ollama-local",
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": "",
      "model": "replace-with-installed-ollama-model",
      "priority": 5,
      "enabled": false,
      "allow_private_network": true,
      "allow_insecure_http": true
    },
    {
      "name": "lmstudio-local",
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:1234/v1",
      "api_key_env": "",
      "model": "replace-with-loaded-lm-studio-model",
      "priority": 5,
      "enabled": false,
      "allow_private_network": true,
      "allow_insecure_http": true
    },
    {
      "name": "vllm-local",
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "",
      "model": "replace-with-served-vllm-model",
      "priority": 5,
      "enabled": false,
      "allow_private_network": true,
      "allow_insecure_http": true
    },
    {
      "name": "localai-local",
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key_env": "",
      "model": "replace-with-localai-model",
      "priority": 5,
      "enabled": false,
      "allow_private_network": true,
      "allow_insecure_http": true
    }
  ]
}
