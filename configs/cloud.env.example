# KINGAIBOT v1.8 Cloud / Fleet enrollment
# Keep this file readable only by the service account/root on production hosts.
# Enrollment tokens are one-time credentials and should be removed after successful enrollment.

KINGAI_CLOUD_ENABLED=1
KINGAI_CLOUD_BASE_URL=https://api.kingai.work
KINGAI_ENROLLMENT_TOKEN=
KINGAI_CLOUD_ENVIRONMENT=production
KINGAI_NODE_CLASS=server
KINGAI_NODE_PROVIDER=
KINGAI_NODE_REGION=
KINGAI_CLOUD_HEARTBEAT_SECONDS=60

# Optional enterprise fail-closed startup. Default is local-first (0):
# the local Runtime continues under local Authority/Approval/Audit if cloud is unavailable.
KINGAI_CLOUD_REQUIRE_POLICY=0

# End-to-end encrypted continuity sync is opt-in.
# Generate 32 random bytes and encode them as base64. The key must be provisioned
# to the devices that are intentionally allowed to share continuity; never upload
# the key to KING AI Cloud.
KINGAI_MEMORY_SYNC=0
KINGAI_MEMORY_SYNC_SECONDS=900
KINGAI_SYNC_KEY=

# Custom cloud endpoints are disabled by default. Production pins api.kingai.work.
KINGAI_CLOUD_ALLOW_CUSTOM_ENDPOINT=0
